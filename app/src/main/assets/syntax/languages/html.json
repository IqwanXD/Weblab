{
  "name": "html",
  "extensions": [
    "html",
    "htm",
    "svg"
  ],
  "hashColorAlphaFirst": true,
  "tagIndent": true,
  "rules": [
    {
      "scope": "comment",
      "pattern": "<!--[\\s\\S]*?(?:-->|\\z)"
    },
    {
      "scope": "comment",
      "pattern": "<\\?[\\s\\S]*?(?:\\?>|\\z)"
    },
    {
      "scope": "string",
      "pattern": "\"[^\"\\n]*\"|'[^'\\n]*'"
    },
    {
      "scope": "tag",
      "pattern": "</?[A-Za-z][\\w:.-]*"
    },
    {
      "scope": "tag",
      "pattern": "/?>"
    },
    {
      "scope": "attribute",
      "pattern": "[A-Za-z_:][\\w:.-]*(?=\\s*=)"
    },
    {
      "scope": "number",
      "pattern": "&\\w+;"
    }
  ],
  "embed": [
    {
      "start": "<script\\b[^>]*>",
      "end": "</script\\s*>",
      "language": "javascript"
    },
    {
      "start": "<style\\b[^>]*>",
      "end": "</style\\s*>",
      "language": "css"
    }
  ]
}